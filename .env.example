# ---------------------------------------------------------------------------
# Ontology AI Agent Demo — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed.
# The application loads these via python-dotenv at startup.

# --- Database ---
# Path to the SQLite database file (relative to project root or absolute).
DB_PATH=./data/banking_risk.db

# --- Application ---
APP_TITLE=Ontology AI Agent · Risk Monitoring Demo
DEFAULT_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM (openjiuwen ReActAgent) ---
# Leave OPENAI_API_KEY / OPENAI_API_BASE empty to run in schema-aware fallback
# mode (deterministic, no LLM needed). Fill both in to enable the real
# openjiuwen agent-core ReActAgent on the Analysis tab.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_MODEL=gpt-4o-mini

# --- Agent memory persistence (JiuwenMemory kernel) ---
# Memory units persist to SQLite (data/memory/kv.db), the semantic vector
# index to Milvus, and both ontology graphs to GraphML (data/memory/graph/).
# By default the vector index uses an EMBEDDED local Milvus (milvus-lite,
# data/memory/milvus.db) — no server needed. Point MILVUS_URI at a
# standalone/remote Milvus to use it instead:
#   MILVUS_URI=http://localhost:19530
MILVUS_URI=
